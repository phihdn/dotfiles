###########
## shell ##
###########
# command = "/opt/homebrew/bin/zsh --login"
# initial-command = "/opt/homebrew/bin/zsh --login -c 'sesh_start'"
shell-integration = zsh
shell-integration-features = "no-cursor,sudo,title"

#################
## UI / window ##
#################
font-family = CommitMono Nerd Font
font-size = 20

theme = Kanagawa Dragon
#theme = Catppuccin Mocha
#theme = Gruvbox Dark

# extra leading for readability. This is safe to raise only because
# window-padding-balance is off below — with balancing on, the leftover
# pixels from a non-divisible viewport get split across all four edges,
# which is what put a gap above the tmux status bar.
adjust-cell-height = 35%
# adjust-cell-height's vertical centering leaves text sitting low in the
# taller cell (most noticeable on solid-bg blocks like the tmux status bar).
# Nudge the baseline up to rebalance; tune in small steps — each change
# needs a full Ghostty restart (not just cmd+shift+, reload) to take effect.
adjust-font-baseline = 15%
# background-opacity = 0.96

bold-is-bright = true
cursor-style = block
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# hides the titlebar while keeping the native frame and rounded corners
macos-titlebar-style = hidden
macos-window-shadow = false

window-decoration = true
# false = the top-left grid cell hugs the window edge; the leftover pixels
# from a viewport that isn't an exact multiple of the cell size all go to the
# bottom/right instead of being split onto the top edge. This is what keeps
# the tmux status bar flush at the top even with a tall adjust-cell-height.
window-padding-balance = false
window-padding-x = 10,10
window-padding-y = 0,0
# bleed a row's own background into the padding strip — keeps the shell
# prompt's padding clean (shell-integration prompt rows are excluded from
# this) while letting the tmux status bar (a fixed-bg row) fill edge-to-edge
window-padding-color = extend
window-save-state = always
window-colorspace = "display-p3"

quit-after-last-window-closed = true

###############
## clipboard ##
###############
clipboard-read = "allow"
# clipboard-trim-trailing-spaces = true
clipboard-write = "allow"
copy-on-select = clipboard

#################
## keybindings ##
#################
# Some useful encoded characters:
# \x0a = Enter/Return
# \x1b = Esc
# \x01 = <C-a> (tmux prefix)
# \x02 = <C-b> (tmux prefix)
macos-option-as-alt = true

# tmux
# switch to window by index (1-based)
keybind = super+physical:one=text:\x021
keybind = super+physical:two=text:\x022
keybind = super+physical:three=text:\x023
keybind = super+physical:four=text:\x024
keybind = super+physical:five=text:\x025
keybind = super+physical:six=text:\x026
keybind = super+physical:seven=text:\x027
keybind = super+physical:eight=text:\x028
keybind = super+physical:nine=text:\x029
# <perfix>+c (new window)
keybind = super+t=text:\x02\x63
# <perfix>+x (close window)
keybind = super+w=text:\x02\x78
# <perfix>+u (open url)
keybind = super+o=text:\x02\x75

# sesh
# <perfix>+k (open sesh picker)
keybind = super+k=text:\x02\x4b
# <perfix>+l (switch to last session)
keybind = super+l=text:\x02\x4c

# neovim
# <Esc>:w (write buffer)
keybind = super+s=text:\x1b\x3a\x77\x0a
# <Esc><Space>ff (open file by telescope)
keybind = super+p=text:\x1b\x20\x66\x66
keybind = shift+enter=text:\x1b\r
