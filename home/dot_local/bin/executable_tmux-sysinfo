#!/usr/bin/env bash
#
# tmux-sysinfo: CPU and memory utilization segments for the tmux status line.
# Wired up in tmux.conf via:
#   set -ag status-right "#(tmux-sysinfo 'fg=...' 'fg=...' 'fg=...,bg=...')"
#
# Emits its own #[...] sequences (the same trick tmux-uptime and gitmux use) so
# one invocation can paint both segments — icon in the accent style, value in the
# text style, or the alert style once memory crosses the threshold. Every style
# is passed in so the color palette stays in tmux.conf.
#
# Both percentages are right-aligned in a fixed 3-column field ("%3.0f"). Without
# the padding a reading crossing 9%/99% changes the segment width, which shifts
# every neighbouring segment sideways on each refresh. Keep the width.

accent_style="${1:-fg=blue}"
value_style="${2:-default}"
alert_style="${3:-fg=red}"
# Percent of physical memory in use at which the memory value turns alert-styled.
mem_alert="${TMUX_SYSINFO_MEM_ALERT:-85}"

os=$(uname -s)

# Previous CPU sample, per user so two accounts on one box never clobber each
# other. Holds "<total_ticks> <idle_ticks>" — see cpu_ticks.
cpu_state="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tmux-sysinfo-cpu.$(id -u)"

# Cumulative "<total> <idle>" tick counters since boot, whatever the unit.
# Utilization is the delta between two refreshes, so the counters only have to
# be monotonic and consistent with each other.
#
# Deliberately *not* `ps -A -o %cpu=`: that column is a per-process decaying
# average over roughly the last minute, so summing it lags reality and badly
# overstates while a burst decays — measured 267% against a true 53%, and 23%
# against a true 14.7%. It also cannot see CPU the kernel never attributes to a
# process. Cumulative counters have neither problem.
cpu_ticks() {
  case "$os" in
  Darwin)
    # host_statistics64(HOST_CPU_LOAD_INFO) — the same counters `top` and
    # Activity Monitor read: USER, SYSTEM, IDLE, NICE ticks since boot. There is
    # no sysctl for these and no shell tool that reports them without a sampling
    # delay (`top -l 2` costs 1.4s, `iostat -c 2` a full second), so this reads
    # them straight from libSystem. ~40ms.
    "$python3" -c '
import ctypes, ctypes.util
libc = ctypes.CDLL(ctypes.util.find_library("c"))
class CpuLoad(ctypes.Structure):
    _fields_ = [("ticks", ctypes.c_uint * 4)]   # USER, SYSTEM, IDLE, NICE
libc.mach_host_self.restype = ctypes.c_uint
info, count = CpuLoad(), ctypes.c_uint(4)
if libc.host_statistics64(libc.mach_host_self(), 3,
                          ctypes.byref(info), ctypes.byref(count)) != 0:
    raise SystemExit(1)
u, s, i, n = info.ticks
print(u + s + i + n, i)
' 2> /dev/null
    ;;
  Linux)
    # /proc/stat: user nice system idle iowait irq softirq steal ...
    # Idle is idle + iowait; both are time the CPU had nothing runnable.
    awk '/^cpu /{
      total = 0
      for (i = 2; i <= NF; i++) total += $i
      print total, $5 + $6
      exit
    }' /proc/stat
    ;;
  esac
}

# Percentage of total CPU capacity in use, across all logical cores.
cpu_percent() {
  local now prev
  now=$(cpu_ticks)
  # Without counters there is no honest number to show, so say so rather than
  # print a plausible-looking wrong one.
  [[ -n $now ]] || { printf '%3s' '--'; return 0; }

  prev=""
  [[ -r $cpu_state ]] && read -r prev < "$cpu_state"
  printf '%s\n' "$now" > "$cpu_state"

  # No previous sample (first run after boot) falls back to the since-boot
  # average, which is what a single reading of these counters actually means.
  awk -v now="$now" -v prev="$prev" '
    BEGIN {
      split(now, a, " ")
      n = split(prev, b, " ")
      if (n == 2) { total = a[1] - b[1]; idle = a[2] - b[2] }
      # A counter that went backwards means the state file is stale or from
      # another boot; treat it as if there were no previous sample.
      if (n != 2 || total <= 0 || idle < 0) { total = a[1]; idle = a[2] }
      pct = (total > 0) ? 100 * (total - idle) / total : 0
      if (pct < 0) pct = 0
      if (pct > 100) pct = 100
      printf "%3.0f", pct
    }'
}

# Percentage of physical memory in use.
mem_percent() {
  case "$os" in
  Darwin)
    # Anonymous + wired + compressed: the pages that cannot be handed to another
    # process without swapping. This is what Activity Monitor calls "Memory
    # Used".
    #
    # Anonymous, not active: "active" mixes in file-backed pages, which are
    # reclaimable, while leaving out inactive anonymous pages, which are not.
    # Using it read 66.7% on a machine sitting at 74.4% with 0.08 GB free and
    # 1.8 GB of swap in use — understating exactly when the number matters.
    local total
    total=$(sysctl -n hw.memsize)
    vm_stat | awk -v total="$total" '
      /page size of/ { for (i = 1; i <= NF; i++) if ($i == "of") psize = $(i + 1) }
      /^Anonymous pages/                  { gsub(/\./, "", $NF); used += $NF }
      /^Pages wired down/                 { gsub(/\./, "", $NF); used += $NF }
      /^Pages occupied by compressor/     { gsub(/\./, "", $NF); used += $NF }
      END { printf "%3.0f", 100 * used * psize / total }'
    ;;
  Linux)
    # MemAvailable is the kernel's own estimate of what a new workload can claim
    # without swapping, which already accounts for reclaimable cache.
    awk '
      /^MemTotal:/     { total = $2 }
      /^MemAvailable:/ { avail = $2 }
      END { printf "%3.0f", 100 * (total - avail) / total }' /proc/meminfo
    ;;
  esac
}

# Resolved once, not per call. /usr/bin/python3 is the stock macOS copy, used
# when PATH has no python3 — a tmux status job inherits the server's PATH, fixed
# whenever the server started.
python3=$(command -v python3 || true)
[[ -z $python3 && -x /usr/bin/python3 ]] && python3=/usr/bin/python3

cpu=$(cpu_percent)
mem=$(mem_percent)

# Alert only on memory: it is the reading that tells you the machine is about to
# start swapping, and a CPU spike is normal and self-correcting.
mem_style="$value_style"
[[ $mem =~ ^[[:space:]]*[0-9]+$ ]] && ((mem >= mem_alert)) && mem_style="$alert_style"

printf '#[%s] #[%s]%s%% ' "$accent_style" "$value_style" "$cpu"
printf '#[%s] #[%s]%s%% #[default]' "$accent_style" "$mem_style" "$mem"
