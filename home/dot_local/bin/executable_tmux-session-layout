#!/usr/bin/env bash
# tmux session-created hook: apply a layout based on the session's path.
# Wired up in tmux.conf via:
#   set-hook -g session-created 'run-shell "~/.local/bin/tmux-session-layout #{q:hook_session_name} #{q:session_path}"'
# Repo sessions under ~/ws/work|personal get:
#   1: claude (focused)   2: plain shell
# nvim is started by hand in window 2 when actually editing — auto-spawning it
# per session piles up typescript-language-server/eslint node processes across
# parallel worktree sessions. Lazygit is on demand via the prefix+g popup (see
# tmux.conf), not a window. Add more `case` branches for other path patterns.
#
# Session names: sesh already qualifies worktree sessions as <repo>/<worktree>
# (e.g. user-service/PORTAL-8750) when it detects the .bare layout, so equally
# named worktrees of different repos never collide — no renaming needed here.
# All tmux targets below use "=$session..." exact matching, which is safe with
# a "/" in the session name (verified against a live session).

session="$1"
path="$2"
{ [ -n "$session" ] && [ -d "$path" ]; } || exit 0

# Only lay out real working trees — not umbrella folders like ~/ws/work, and
# not bare-clone roots (git-wt layout), where rev-parse prints "false" but
# still exits 0. Bare roots stay plain shell hubs for git wt / lg.
[ "$(git -C "$path" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] || exit 0

# Detached HEAD means a read-only review checkout ("git wt review"): keep the
# plain shell window only — no persistent claude window. Lazygit stays
# reachable via the prefix+g popup.
git -C "$path" symbolic-ref -q HEAD >/dev/null 2>&1 || exit 0

case "$path" in
  "$HOME/ws/work/"*)     claude_cfg="$HOME/.claude-work" ;;
  "$HOME/ws/personal/"*) claude_cfg="$HOME/.claude-personal" ;;
  *) exit 0 ;;
esac

# Skip if the session already has a claude window (e.g. sesh config sessions).
tmux list-windows -t "=$session" -F '#{window_name}' | grep -q '^claude' && exit 0

# Window 1 is sesh's plain shell (no startup command, so no send-keys race to
# wait out). Add the claude window and swap it to the front.
# "; exec \$SHELL" returns to a shell instead of closing the window on exit.
tmux new-window -d -t "=$session" -n claude -c "$path" \
  "CLAUDE_CONFIG_DIR=$claude_cfg claude; exec \$SHELL"
# Swap so the order is claude(1), shell(2), then land on claude.
tmux swap-window -d -s "=$session:1" -t "=$session:2"
tmux select-window -t "=$session:1"
