#!/usr/bin/env bash
#
# tmux-meeting: the next meeting, for the tmux status line.
#
# Reads macOS Calendar.app through icalBuddy. A Google Calendar gets here by
# being added under System Settings -> Internet Accounts; nothing talks to
# Google directly, so a calendar missing from Calendar.app is invisible here.
#
# Wired up in tmux.conf via:
#   set -ag status-right "#(tmux-meeting status 'normal' 'soon' 'imminent' 'flash-off')"
#   bind M display-popup -E "tmux-meeting pick"
#
# Modes:
#   status      the status-line segment (default)
#   url         the next meeting's video-call link, if it has one
#   join        open that link in the browser
#   pick        choose among the meetings you could join now, then open it
#
# Styles are emitted here rather than in tmux.conf because which one applies
# depends on how near the meeting is, and tmux formats cannot decide that.
#
# icalBuddy costs ~0.5s a call, so the calendar is read at most once per
# cache_ttl; every refresh in between only recomputes the countdown.

set -uo pipefail

# Machine-local settings, sourced first so it can set anything below. Holds the
# calendar names — account addresses, so it is untracked and .chezmoiignore'd.
# See the tmux section of the README for the two lines it needs.
#
# A file rather than an exported variable: status commands inherit the tmux
# *server's* environment, fixed when the server started, so a later `export`
# would never reach here. Write assignments as VAR="${VAR:-value}" so an
# explicit environment variable still wins.
config_file="${TMUX_MEETING_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/meeting.env}"
# shellcheck source=/dev/null
[[ -r $config_file ]] && . "$config_file"

mode="${1:-status}"
normal_style="${2:-fg=blue}"
soon_style="${3:-fg=yellow}"
imminent_style="${4:-fg=black,bg=red}"
# Off-phase of the imminent flash. Terminals ignore the blink attribute (SGR 5)
# — Ghostty renders it solid — so the segment alternates two styles of its own.
imminent_alt_style="${5:-fg=red}"

# Two days ahead, so a Friday evening still shows Monday morning.
lookahead_days="${TMUX_MEETING_LOOKAHEAD_DAYS:-2}"
# Seconds before the calendar is read again.
cache_ttl="${TMUX_MEETING_CACHE_TTL:-60}"
# Minutes out at which the segment turns yellow, then a flashing red block.
soon_minutes="${TMUX_MEETING_SOON_MINUTES:-10}"
imminent_minutes="${TMUX_MEETING_IMMINENT_MINUTES:-2}"
# Minutes out at which the announcement fires, once per meeting.
alert_minutes="${TMUX_MEETING_ALERT_MINUTES:-5}"
# How long that announcement stays on the message line.
alert_display_ms="${TMUX_MEETING_ALERT_DISPLAY_MS:-5000}"
# Status-interval the bar borrows while flashing, so a phase change lands
# promptly instead of up to a whole normal refresh late. It is a nudge, not the
# flash rate: tmux does not always re-arm its status timer when this changes,
# so the phase below cannot assume the bar actually sped up.
flash_interval="${TMUX_MEETING_FLASH_INTERVAL:-1}"
# Seconds each phase of the imminent flash is held. Must be no shorter than the
# slowest refresh the bar might still be running at, or the alternation aliases
# against it — see cmd_status.
flash_phase_seconds="${TMUX_MEETING_FLASH_PHASE_SECONDS:-2}"
# How far ahead the picker looks: anything in progress or starting within this
# many minutes is something you could plausibly join right now.
pick_minutes="${TMUX_MEETING_PICK_MINUTES:-60}"
# Truncation width, so one long title cannot push the bar around.
title_width="${TMUX_MEETING_TITLE_WIDTH:-24}"
# Events per read. The first one not yet ended wins, so this only has to exceed
# the number already over today.
max_events="${TMUX_MEETING_MAX_EVENTS:-24}"
# Calendars to watch, named as `icalBuddy calendars` prints them (for a Google
# account, the address itself). Empty watches every calendar, which mixes
# personal events into a work bar.
calendars="${TMUX_MEETING_CALENDARS:-}"

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-meeting"
# Named for the list it now holds; the old single-line "next" file had a
# different layout, so a leftover copy is ignored rather than misread.
cache_file="$cache_dir/events"
alert_file="$cache_dir/alerted"
# Remembers the bar's normal status-interval while the flash borrows a faster
# one, so tmux.conf stays the only place that rate is written down.
#
# Keyed by socket, because the `tmux` calls below target whichever server
# invoked us ($TMUX) while the cache directory is shared by all of them. With
# one common file a second server -- a throwaway `tmux -L test`, or another
# login -- saves its own interval over the real server's, and the restore then
# sets the wrong rate. $TMUX is "socket,pid,session", and the substitution is
# free where `tmux display -p` would cost another fork.
interval_key=${TMUX%%,*}
interval_file="$cache_dir/status-interval${interval_key//\//-}"

# icalBuddy is macOS-only, so elsewhere the segment vanishes rather than
# erroring into the status line.
[[ $(uname -s) == Darwin ]] || exit 0
command -v icalBuddy > /dev/null 2>&1 || exit 0

# Turns icalBuddy's indented output into one tab-separated record per event:
# start date, start time, end date, end time, title, then every other property
# flattened onto one line for the link search. A title sits at column 0 and its
# properties are indented — that is what separates one event from the next.
parse_events() {
  awk '
    function flush() {
      if (title != "" && sd != "")
        printf "%s\t%s\t%s\t%s\t%s\t%s\n", sd, st, ed, et, title, props
      title = ""; sd = ""; st = ""; ed = ""; et = ""; props = ""
    }
    { gsub(/\t/, " ") }
    /^[^ ]/ { flush(); title = $0; sub(/[ \t]+$/, "", title); next }
    {
      props = props " " $0
      if (sd != "") next
      # "    2026-08-28 at 12:00 - 13:00", or with a second date when the
      # event runs past midnight.
      if (match($0, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] at [0-9][0-9]:[0-9][0-9]/)) {
        s = substr($0, RSTART, RLENGTH)
        sd = substr(s, 1, 10); st = substr(s, 15, 5)
        rest = substr($0, RSTART + RLENGTH)
        if (match(rest, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] at [0-9][0-9]:[0-9][0-9]/)) {
          e = substr(rest, RSTART, RLENGTH)
          ed = substr(e, 1, 10); et = substr(e, 15, 5)
        } else if (match(rest, /[0-9][0-9]:[0-9][0-9]/)) {
          ed = sd; et = substr(rest, RSTART, RLENGTH)
        }
      }
    }
    END { flush() }
  '
}

# First video-call link anywhere in the event. Google hides the Meet link in the
# description and Zoom or Teams use the location or url field, so search the lot
# and filter by host instead of trusting one field.
extract_url() {
  printf '%s\n' "$1" |
    grep -oE 'https?://[^[:space:]"<>]+' |
    grep -iE 'meet\.google\.com|zoom\.us|teams\.microsoft\.com|teams\.live\.com|webex\.com|whereby\.com|chime\.aws' |
    head -1 |
    sed 's/[.,;:)]*$//'
}

# Caches every meeting still to come, one per line, earliest first:
# "start_epoch<TAB>end_epoch<TAB>title<TAB>url". The status line only reads the
# first; the picker needs the rest, including any that clash. An empty file
# means nothing is coming up — a real answer, cached like any other.
refresh_cache() {
  local from to raw now sd st ed et title props start_epoch end_epoch url
  local -a cal_filter=()

  from=$(date +%Y-%m-%d)
  to=$(date -v+"${lookahead_days}"d +%Y-%m-%d)
  now=$(date +%s)

  [[ -n $calendars ]] && cal_filter=(--includeCals "$calendars")

  # ${a[@]+"${a[@]}"} expands to nothing when the array is empty instead of
  # tripping `set -u` under the bash 3.2 macOS ships.
  raw=$(icalBuddy \
    ${cal_filter[@]+"${cal_filter[@]}"} \
    --noCalendarNames \
    --bullet "" \
    --excludeAllDayEvents \
    --limitItems "$max_events" \
    --includeEventProps "title,datetime,url,location,notes" \
    --propertyOrder "title,datetime,url,location,notes" \
    --dateFormat "%Y-%m-%d" \
    --timeFormat "%H:%M" \
    --noRelativeDates \
    eventsFrom:"$from" to:"$to" 2> /dev/null)

  : > "$cache_file.tmp"
  # Not icalBuddy's --includeOnlyEventsFromNowOn: it filters on start time, which
  # drops a meeting the moment it begins. Filtering on end time instead keeps an
  # in-progress meeting on the bar until it is over.
  while IFS=$'\t' read -r sd st ed et title props; do
    [[ -n $ed && -n $et ]] || continue
    end_epoch=$(date -j -f "%Y-%m-%d %H:%M" "$ed $et" +%s 2> /dev/null) || continue
    ((end_epoch > now)) || continue
    start_epoch=$(date -j -f "%Y-%m-%d %H:%M" "$sd $st" +%s 2> /dev/null) || continue
    url=$(extract_url "$props")
    printf '%s\t%s\t%s\t%s\n' "$start_epoch" "$end_epoch" "$title" "$url" >> "$cache_file.tmp"
  done < <(printf '%s\n' "$raw" | parse_events)

  # icalBuddy already sorts by date, but the first line has to be the next
  # meeting for the status line, so do not depend on that.
  sort -n -o "$cache_file.tmp" "$cache_file.tmp"
  mv -f "$cache_file.tmp" "$cache_file"
}

ensure_cache() {
  local age
  mkdir -p "$cache_dir"
  if [[ -f $cache_file ]]; then
    age=$(($(date +%s) - $(stat -f %m "$cache_file")))
    ((age < cache_ttl)) && return 0
  fi
  refresh_cache
}

# Populates start/end/title/url from the first cached line — the next meeting.
# Non-zero when nothing is upcoming.
load_meeting() {
  ensure_cache
  [[ -s $cache_file ]] || return 1
  IFS=$'\t' read -r start end title url < "$cache_file"
  [[ -n ${start:-} ]]
}

# Speeds the whole bar up while flashing, saving the rate it replaced. Saving to
# a file means an interrupted run still restores the right rate next refresh.
start_flashing() {
  local current
  current=$(tmux show -gv status-interval 2> /dev/null) || return 0
  [[ $current == "$flash_interval" ]] && return 0
  printf '%s' "$current" > "$interval_file"
  tmux set -g status-interval "$flash_interval" 2> /dev/null
}

# Only a flash that actually borrowed the interval pays a tmux call; every other
# refresh costs one file test.
stop_flashing() {
  [[ -s $interval_file ]] || return 0
  tmux set -g status-interval "$(cat "$interval_file")" 2> /dev/null
  rm -f "$interval_file"
}

# Announces the meeting once. The marker holds the announced meeting's start
# time, so a fast refresh cannot re-trigger it; a time window alone would either
# fire repeatedly or fall between polls.
#
# display-message, not display-popup: a popup is modal and its body ended in a
# `read`, so it captured the keyboard until dismissed -- an alert that fires
# while you are mid-edit in nvim reads as tmux having frozen. This prints to the
# message line and expires on its own. prefix+M still opens the picker when you
# actually want to join.
maybe_alert() {
  local diff="$1" start="$2" title="$3" url="$4" when msg
  ((diff > 0 && diff <= alert_minutes * 60)) || return 0
  [[ -f $alert_file && $(cat "$alert_file" 2> /dev/null) == "$start" ]] && return 0
  printf '%s' "$start" > "$alert_file"

  when=$(date -r "$start" "+%H:%M")
  msg="󰃭 $when  $title"
  [[ -n $url ]] && msg="$msg  ·  $url"
  # display-message reads its argument as a format, where # introduces a
  # substitution -- a title containing one would be mangled or, worse, expand.
  tmux display-message -d "$alert_display_ms" "${msg//#/##}" > /dev/null 2>&1
}

cmd_status() {
  local now diff style countdown when shown
  if ! load_meeting; then
    stop_flashing
    printf '#[%s]󱁕 #[default]' "$normal_style"
    return 0
  fi

  now=$(date +%s)
  diff=$((start - now))

  if ((diff <= imminent_minutes * 60)); then
    style="$imminent_style"
    # Flash only while the meeting is still ahead: it stays on the bar until the
    # meeting ends, and a long one must not strobe for its whole duration.
    #
    # The phase comes off the wall clock, not a counter, so it stays steady
    # however many times tmux expands the format — a redraw sometimes runs the
    # command twice, which a counter would toggle straight back. The phase is
    # held flash_phase_seconds rather than one second because the bar is only
    # asked to refresh every second and is not guaranteed to obey: sampling a
    # one-second alternation once every two seconds always lands on the same
    # phase, and the segment sits frozen on one colour instead of flashing.
    if ((diff > 0)); then
      start_flashing
      (((now / flash_phase_seconds) % 2)) && style="$imminent_alt_style"
    else
      stop_flashing
    fi
  elif ((diff <= soon_minutes * 60)); then
    stop_flashing
    style="$soon_style"
  else
    stop_flashing
    style="$normal_style"
  fi

  # Fixed 5-column field, like tmux-sysinfo's percentages: an unpadded countdown
  # changes width as it ticks and drags its neighbours sideways.
  if ((diff <= 0)); then
    countdown="now"
  elif ((diff < 3600)); then
    countdown="$(((diff + 59) / 60))m"
  else
    countdown="$((diff / 3600))h$(printf '%02d' $(((diff % 3600) / 60)))m"
  fi
  countdown=$(printf '%5s' "$countdown")

  shown="$title"
  ((${#shown} > title_width)) && shown="${shown:0:title_width-1}…"

  when=$(date -r "$start" "+%H:%M")
  printf '#[%s]󰃭 %s %s %s #[default]' "$style" "$when" "$shown" "$countdown"

  maybe_alert "$diff" "$start" "$title" "$url"
}

cmd_url() {
  load_meeting || return 0
  [[ -n ${url:-} ]] && printf '%s\n' "$url"
}

cmd_join() {
  if ! load_meeting; then
    tmux display-message "no upcoming meeting"
    return 0
  fi
  if [[ -z ${url:-} ]]; then
    tmux display-message "no video link on: $title"
    return 0
  fi
  open "$url"
}

# One row per joinable meeting: the label fzf shows, then the url and the bare
# title in fields --with-nth hides, so a message can name the meeting without
# the label's time and countdown decoration. Two meetings at the same time are
# two rows, which is the whole point of the picker.
pick_rows() {
  local now start end title url when mark note
  now=$(date +%s)
  while IFS=$'\t' read -r start end title url; do
    [[ -n ${start:-} && -n ${end:-} ]] || continue
    ((end > now)) || continue
    ((start - now <= pick_minutes * 60)) || continue
    when=$(date -r "$start" "+%H:%M")
    if ((start <= now)); then
      mark="now"
    else
      mark="in $(((start - now + 59) / 60))m"
    fi
    # Kept in the list even without a link, so a clash is still visible and it
    # is obvious which of the two is the joinable one.
    [[ -n $url ]] && note="" || note="  · no video link"
    printf '%s  %-7s  %s%s\t%s\t%s\n' "$when" "$mark" "$title" "$note" "$url" "$title"
  done < "$cache_file"
}

# Waits for a key because the popup is -E: without it the message would vanish
# the instant this returns.
pick_notice() {
  printf '\n  %s\n\n  [any key] close\n' "$1"
  read -r -n 1 _
}

cmd_pick() {
  local rows sel label url title
  ensure_cache
  # Nothing to choose between without fzf; the direct join still works.
  command -v fzf > /dev/null 2>&1 || {
    cmd_join
    return 0
  }

  rows=$(pick_rows)
  if [[ -z $rows ]]; then
    pick_notice "no meeting in the next $pick_minutes minutes"
    return 0
  fi

  sel=$(printf '%s\n' "$rows" | fzf \
    --delimiter=$'\t' --with-nth=1 \
    --reverse --no-sort --no-multi \
    --prompt '󰃭 join > ' \
    --header 'enter joins · esc cancels') || return 0
  [[ -n $sel ]] || return 0

  # cut, not read: tab counts as IFS whitespace, so `read` collapses the empty
  # url of a linkless meeting and shifts the title into its place — which then
  # gets handed to `open` as if it were a link.
  url=$(printf '%s' "$sel" | cut -f2)
  title=$(printf '%s' "$sel" | cut -f3)
  if [[ -z $url ]]; then
    pick_notice "no video link on: $title"
    return 0
  fi
  open "$url"
}

case "$mode" in
  status) cmd_status ;;
  url) cmd_url ;;
  join) cmd_join ;;
  pick) cmd_pick ;;
  *)
    printf 'usage: %s [status|url|join|pick]\n' "${0##*/}" >&2
    exit 64
    ;;
esac
