#!/usr/bin/env bash
# Translates program names to icons, so we an use them in our tmux config.
# Based on https://github.com/caarlos0/icons

# tmux names a pane after the basename of its foreground program's executable
# path. Claude Code's native installer points ~/.local/bin/claude at a binary
# named after the version (~/.local/share/claude/versions/2.1.250), so the pane
# command arrives as a bare version number instead of "claude". Map that back
# before matching; the Homebrew cask install keeps the real name and is
# unaffected either way.
#
# Runs once per window on every tmux-status-daemon tick (which stores the
# glyph in the window's @win_icon option), so it must stay a pure string
# match with no subprocesses. This was a fish script until fish startup (~40ms,
# versus ~1ms for bash) made it the most expensive thing on the status line:
# three windows meant three fish interpreters every refresh.

cmd="${1:-}"

if [[ $cmd =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
  cmd=claude
fi

case "$cmd" in
  ack|fd|find|fzf|grep|rg)
    echo 
    ;;
  atop|htop|top)
    echo 
    ;;
  bash|fish|zsh|sh|ash)
    echo 
    ;;
  bat|cat)
    echo 
    ;;
  clx)
    echo 
    ;;
  cp|duplicate)
    echo 
    ;;
  mv)
    echo 󰉒
    ;;
  curl|http|pint|lynx|wget|w3m)
    echo 
    ;;
  docker|docker-compose|podman)
    echo 
    ;;
  lf|ls|nnn|ranger|lsd)
    echo 
    ;;
  elixir|mix)
    echo 
    ;;
  gh|gh-dash)
    echo 
    ;;
  git|lazygit|tig)
    echo 
    ;;
  glow)
    echo 
    ;;
  go|goreleaser)
    echo 
    ;;
  kubectl|k9s)
    echo 
    ;;
  java|mvn)
    echo 
    ;;
  less|more)
    echo 
    ;;
  lua)
    echo 
    ;;
  man)
    echo 
    ;;
  nano|pico)
    echo 
    ;;
  node|npm|yarn)
    echo 
    ;;
  nix*)
    echo 󱄅
    ;;
  vim|vi)
    echo 
    ;;
  nvim)
    echo 
    ;;
  python|pip)
    echo 
    ;;
  rm)
    echo 
    ;;
  rsync)
    echo 
    ;;
  ruby|irb)
    echo 
    ;;
  scp|ssh)
    echo 󰣀
    ;;
  sleep)
    echo 
    ;;
  sudo)
    echo 
    ;;
  tail)
    echo 
    ;;
  task|make)
    echo 
    ;;
  tmux)
    echo 
    ;;
  # glob so wrappers and aliases (claude-work, claude-personal, ...) match;
  # note plain aliases already exec the claude binary, so tmux usually
  # reports just "claude" regardless
  *claude*)
    echo 
    ;;
  youtube-dl)
    echo 
    ;;
  # Fallback: the tmux status line shows the icon alone (no program name),
  # so an unmatched command must still render something identifiable.
  *)
    echo 
    ;;
esac
