#!/usr/bin/env fish
# Translates program names to icons, so we an use them in our tmux config.
# Based on https://github.com/caarlos0/icons

# tmux names a pane after the basename of its foreground program's executable
# path. Claude Code's native installer points ~/.local/bin/claude at a binary
# named after the version (~/.local/share/claude/versions/2.1.250), so the pane
# command arrives as a bare version number instead of "claude". Map that back
# before matching; the Homebrew cask install keeps the real name and is
# unaffected either way.
set -l cmd $argv[1]
if string match -qr '^[0-9]+\.[0-9]+\.[0-9]+' -- $cmd
    set cmd claude
end

switch $cmd
    case ack fd find fzf grep rg
        echo 
    case atop htop top
        echo 
    case bash fish zsh sh ash
        echo 
    case bat cat
        echo 
    case clx
        echo 
    case cp duplicate
        echo 
    case mv
        echo 󰉒
    case curl http pint lynx wget w3m
        echo 
    case docker docker-compose podman
        echo 
    case lf ls nnn ranger lsd
        echo 
    case elixir mix
        echo 
    case gh gh-dash
        echo 
    case git lazygit tig
        echo 
    case glow
        echo 
    case go goreleaser
        echo 
    case kubectl k9s
        echo 
    case java mvn
        echo 
    case less more
        echo 
    case lua
        echo 
    case man
        echo 
    case nano pico
        echo 
    case node npm yarn
        echo 
    case 'nix*'
        echo 󱄅
    case vim vi
        echo 
    case nvim
        echo 
    case python pip
        echo 
    case rm
        echo 
    case rsync
        echo 
    case ruby irb
        echo 
    case scp ssh
        echo 󰣀
    case sleep
        echo 
    case sudo
        echo 
    case tail
        echo 
    case task make
        echo 
    case tmux
        echo 
    # glob so wrappers and aliases (claude-work, claude-personal, ...) match;
    # note plain aliases already exec the claude binary, so tmux usually
    # reports just "claude" regardless
    case '*claude*'
        echo " "
    case youtube-dl
        echo 
    # Fallback: the tmux status line shows the icon alone (no program name),
    # so an unmatched command must still render something identifiable.
    case '*'
        echo 
end
